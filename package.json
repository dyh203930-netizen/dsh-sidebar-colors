{
  "name": "@local/sidebar-colors",
  "version": "1.0.0",
  "private": true,
  "description": "侧边栏行颜色：会话标题文字自定义颜色，工作区标题行自定义背景色",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "sidebar",
    "colors"
  ],
  "author": "dyh203930-netizen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyh203930-netizen/dsh-sidebar-colors.git"
  },
  "homepage": "https://github.com/dyh203930-netizen/dsh-sidebar-colors#readme",
  "bugs": {
    "url": "https://github.com/dyh203930-netizen/dsh-sidebar-colors/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
